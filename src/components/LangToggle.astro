---
import type { Lang } from '@/i18n/ui';
import { langs, localizePath, useTranslations } from '@/i18n/utils';
import { isBuilt } from '@/lib/routes';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);
const options = langs
  .filter((option) => isBuilt(localizePath('/', option)))
  .map((option) => {
    const samePage = localizePath(currentPath, option);
    return { option, href: isBuilt(samePage) ? samePage : localizePath('/', option) };
  });
---

{options.length > 1 && (
  <ul class="flex gap-1" aria-label={t('lang.label')}>
    {options.map(({ option, href }) => {
      const current = option === lang;
      return (
        <li>
          <a
            href={href}
            hreflang={option}
            lang={option}
            aria-current={current ? 'true' : undefined}
            class:list={[
              'inline-flex min-h-11 min-w-11 items-center justify-center rounded-md border border-line px-3 no-underline hover:text-white',
              current ? 'bg-chip text-fg' : 'text-muted',
            ]}
          >
            {option}
          </a>
        </li>
      );
    })}
  </ul>
)}
