---
interface Props {
  label: string;
  words: [string, string, string, string];
}

const { label, words } = Astro.props;
---

<span class="inline-flex items-center gap-2 font-mono text-sm text-green">
  <span data-star aria-hidden="true">
    ✻
  </span>
  <span class="sr-only">{label}</span>
  <span data-words aria-hidden="true">
    {words.map((word, index) => (
      <span data-word data-text={word} style={`--index: ${index}`}>
        {word}
      </span>
    ))}
  </span>
</span>

<style>
  [data-words] {
    --step: 2s;
    --cycle: calc(var(--step) * 4);

    display: inline-grid;
  }

  [data-word] {
    position: relative;
    grid-area: 1 / 1;
    opacity: 0;
    white-space: nowrap;
    animation: cycle var(--cycle) infinite;
    animation-delay: calc(var(--step) * var(--index));
  }

  [data-word]::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: transparent;
    background: linear-gradient(
      90deg,
      transparent 35%,
      color-mix(in srgb, var(--color-white) 85%, transparent) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
    background-clip: text;
    animation: shimmer var(--cycle) linear infinite;
    animation-delay: calc(var(--step) * var(--index));
  }

  [data-star] {
    display: inline-block;
    animation: spin 3s linear infinite;
  }

  @keyframes cycle {
    0% {
      opacity: 0;
      transform: translateY(0.25rem);
    }

    4%,
    21% {
      opacity: 1;
      transform: none;
    }

    25%,
    100% {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  @keyframes shimmer {
    0%,
    4% {
      background-position: 150% 0;
    }

    21%,
    100% {
      background-position: -100% 0;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-word],
    [data-word]::after,
    [data-star] {
      animation: none;
    }

    [data-word]:first-child {
      opacity: 1;
    }

    [data-word]::after {
      content: none;
    }
  }
</style>
