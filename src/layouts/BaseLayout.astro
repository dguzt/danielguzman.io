---
import { Font } from 'astro:assets';
import CloudflareAnalytics from '@/components/CloudflareAnalytics.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Seo from '@/components/Seo.astro';
import { defaultLang, type Lang } from '@/i18n/ui';
import { author } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = defaultLang } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content={author} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <Seo title={title} description={description} lang={lang} />
    <Font cssVariable="--font-geist" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-geist-mono" />
    <CloudflareAnalytics token="cf3d7f393c204cfebee88efc82d8f8c0" />
  </head>
  <body>
    <div class="flex min-h-dvh justify-center px-6 py-10 md:py-14 xl:justify-start xl:pl-65">
      <div class="flex w-full max-w-column flex-col gap-16">
        <Header lang={lang} currentPath={Astro.url.pathname} />
        <main class="flex flex-col gap-16">
          <slot />
        </main>
        <div class="mt-auto">
          <Footer lang={lang} />
        </div>
      </div>
    </div>
  </body>
</html>
