---
import CloudflareAnalytics from '@/components/CloudflareAnalytics.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
}

const { title, description, lang = 'en' } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Daniel Guzman" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <CloudflareAnalytics token="cf3d7f393c204cfebee88efc82d8f8c0" />
  </head>
  <body>
    <slot />
  </body>
</html>
